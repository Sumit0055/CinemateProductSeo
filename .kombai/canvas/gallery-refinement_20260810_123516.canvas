      "viewportScrollY": 0
    },
    "var_3fb238de9af4": {
      "type": "variant",
      "label": "Gallery — Cinematic Darkroom",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;500;600&family=Rubik:wght@400;500;600;700&display=swap');\n\n  :root {\n    --darkroom: #0d0d0f;\n    --panel: #151518;\n    --panel-soft: #1b1b20;\n    --paper: #f4eee7;\n    --muted: #a8a2a0;\n    --line: rgba(244, 238, 231, 0.16);\n    --accent: #f62a66;\n    --warm: #d1b7a2;\n  }\n\n  .gallery-shell {\n    min-height: 100vh;\n    background: var(--darkroom);\n    color: var(--paper);\n    font-family: 'Rubik', sans-serif;\n    overflow: hidden;\n  }\n\n  .gallery-display {\n    font-family: 'Josefin Sans', sans-serif;\n    letter-spacing: -0.035em;\n  }\n\n  .gallery-fade {\n    background: linear-gradient(90deg, rgba(13, 13, 15, 0.96) 0%, rgba(13, 13, 15, 0.78) 36%, rgba(13, 13, 15, 0.16) 74%, rgba(13, 13, 15, 0.72) 100%);\n  }\n\n  .halo-image {\n    background-position: center;\n    background-repeat: no-repeat;\n    background-size: cover;\n    filter: blur(30px) saturate(0.88);\n    opacity: 0.46;\n    transform: scale(1.14);\n  }\n\n  .stage-image {\n    filter: saturate(0.97) contrast(1.03);\n    max-height: min(67vh, 650px);\n    object-fit: contain;\n  }\n\n  .filmstrip-scroll::-webkit-scrollbar { display: none; }\n  .filmstrip-scroll { scrollbar-width: none; }\n\n  .thumb-button {\n    border: 1px solid transparent;\n    background: transparent;\n    opacity: 0.56;\n  }\n\n  .thumb-button.is-selected {\n    border-color: var(--accent);\n    opacity: 1;\n    box-shadow: 0 0 0 3px rgba(246, 42, 102, 0.14);\n  }\n\n  .thumb-button:focus-visible,\n  .gallery-control:focus-visible,\n  .frame-link:focus-visible {\n    outline: 2px solid var(--accent);\n    outline-offset: 4px;\n  }\n\n  .gallery-control {\n    border: 1px solid var(--line);\n    background: rgba(21, 21, 24, 0.9);\n  }\n\n  .gallery-control:hover { border-color: rgba(246, 42, 102, 0.86); color: var(--paper); }\n\n  .frame-link { border-bottom: 1px solid rgba(244, 238, 231, 0.42); }\n  .frame-link:hover { border-color: var(--accent); color: var(--paper); }\n\n  .progress-line { background: linear-gradient(90deg, var(--accent) 0 7.14%, rgba(244, 238, 231, 0.2) 7.14% 100%); }\n\n  @media (max-width: 767px) {\n    .gallery-fade { background: linear-gradient(180deg, rgba(13, 13, 15, 0.92) 0%, rgba(13, 13, 15, 0.24) 45%, rgba(13, 13, 15, 0.96) 92%); }\n    .stage-image { max-height: 59vh; }\n  }\n</style>\n<div class=\"gallery-shell\" data-kid=\"1\" data-name=\"gallery application container\">\n    <header class=\"relative z-20 border-b border-white/10\" data-kid=\"1-1\" data-name=\"header navigation container\">\n        <div class=\"mx-auto flex max-w-[1180px] items-center justify-between px-6 py-5 sm:px-10 lg:px-14\" data-kid=\"1-1-1\" data-name=\"header layout wrapper\">\n            <a class=\"flex items-center gap-3 no-underline text-[var(--paper)]\" data-kid=\"1-1-1-1\" data-name=\"logo brand link\" href=\"#gallery\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-full border border-white/25 text-[11px] font-semibold tracking-[0.26em] text-white\" data-kid=\"1-1-1-1-1\" data-name=\"brand initials emblem\">\n                    CM\n                </span>\n                <span class=\"leading-none\" data-kid=\"1-1-1-1-2\" data-name=\"brand name group\">\n                    <span class=\"block text-[11px] font-semibold uppercase tracking-[0.32em]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand primary name\">\n                        Cinemate\n                    </span>\n                    <span class=\"mt-1 block text-[9px] uppercase tracking-[0.36em] text-white/50\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand secondary subtitle\">\n                        Production\n                    </span>\n                </span>\n            </a>\n            <div class=\"hidden items-center gap-8 text-[10px] uppercase tracking-[0.28em] text-white/56 md:flex\" data-kid=\"1-1-1-2\" data-name=\"navigation links group\">\n                <span class=\"text-white/90\" data-kid=\"1-1-1-2-1\" data-name=\"active gallery link\">\n                    Gallery\n                </span>\n                <span data-kid=\"1-1-1-2-2\" data-name=\"stories archive link\">\n                    Stories / 2024—25\n                </span>\n            </div>\n            <button aria-label=\"Open menu\" class=\"gallery-control flex h-10 w-10 items-center justify-center rounded-full text-white/70 transition-colors\" data-kid=\"1-1-1-3\" data-name=\"menu toggle button\" type=\"button\">\n                <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-1-1-3-1\" data-lucide=\"menu\" data-name=\"menu hamburger icon\" data-reason=\"icon rendered by lucide script\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"relative\" data-kid=\"1-2\" data-name=\"main gallery section\" id=\"gallery\">\n        <section class=\"mx-auto max-w-[1180px] px-6 pb-10 pt-10 sm:px-10 sm:pb-14 sm:pt-14 lg:px-14 lg:pt-16\" data-kid=\"1-2-1\" data-name=\"hero information section\">\n            <div class=\"grid gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-end\" data-kid=\"1-2-1-1\" data-name=\"hero content grid\">\n                <div class=\"relative z-10 max-w-[440px]\" data-kid=\"1-2-1-1-1\" data-name=\"hero text content block\">\n                    <div class=\"mb-5 flex items-center gap-3 text-[10px] font-medium uppercase tracking-[0.32em] text-[var(--accent)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero label group\">\n                        <span class=\"h-px w-10 bg-[var(--accent)]\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"hero label decoration line\">\n                        </span>\n                        <span data-kid=\"1-2-1-1-1-1-2\" data-name=\"hero label text\">\n                            Selected frames / 01\n                        </span>\n                    </div>\n                    <h1 class=\"gallery-display max-w-[400px] text-5xl font-medium leading-[0.92] text-[var(--paper)] sm:text-7xl\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero main headline\">\n                        The stories\n                        <em class=\"font-normal text-[var(--warm)]\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"headline emphasis span\">\n                            between\n                        </em>\n                        the frames.\n                    </h1>\n                    <p class=\"mt-6 max-w-[360px] text-sm leading-7 text-white/55\" data-kid=\"1-2-1-1-1-3\" data-name=\"hero subheadline description\">\n                        A living edit of celebrations, quiet glances, and the light that stays after the moment has passed.\n                    </p>\n                </div>\n                <div class=\"flex items-end justify-between border-b border-white/12 pb-4 lg:pb-3\" data-kid=\"1-2-1-1-2\" data-name=\"gallery stats and instructions container\">\n                    <div data-kid=\"1-2-1-1-2-1\" data-name=\"gallery stats group\">\n                        <div class=\"mb-3 text-[9px] uppercase tracking-[0.28em] text-white/40\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"archive location label\">\n                            Archive / Delhi NCR\n                        </div>\n                        <div class=\"flex items-baseline gap-3\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"frame count container\">\n                            <span class=\"gallery-display text-3xl text-white\" data-kid=\"1-2-1-1-2-1-2-1\" data-name=\"frame count number\">\n                                14\n                            </span>\n                            <span class=\"text-xs text-white/40\" data-kid=\"1-2-1-1-2-1-2-2\" data-name=\"frame count label\">\n                                frames in this story\n                            </span>\n                        </div>\n                    </div>\n                    <span class=\"hidden text-right text-[10px] uppercase tracking-[0.24em] text-white/38 sm:block\" data-kid=\"1-2-1-1-2-2\" data-name=\"instruction text for desktop\">\n                        Drag the filmstrip\n                        <br data-kid=\"1-2-1-1-2-2-1\" data-name=\"line break in instructions\"/>\n                        to explore\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Gallery viewer\" class=\"relative mx-auto max-w-[1180px] px-6 sm:px-10 lg:px-14\" data-kid=\"1-2-2\" data-name=\"gallery viewer section\">\n            <div class=\"relative min-h-[470px] overflow-hidden border border-white/10 bg-[var(--panel)] sm:min-h-[590px] lg:min-h-[680px]\" data-kid=\"1-2-2-1\" data-name=\"viewer container\">\n                <div class=\"halo-image absolute inset-0\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1\" data-name=\"blurred background image halo\" data-reason=\"background image replaced by gallery navigation script\" id=\"halo\" style=\"background-image: url('/api/local/images/src/assets/images/gallery/1.jpg');\">\n                </div>\n                <div class=\"absolute inset-0 bg-[#0d0d0f]/55\" data-kid=\"1-2-2-1-2\" data-name=\"dark gradient overlay\">\n                </div>\n                <div class=\"gallery-fade absolute inset-0\" data-kid=\"1-2-2-1-3\" data-name=\"directional fade gradient\">\n                </div>\n                <div class=\"relative z-10 grid min-h-[470px] grid-cols-1 items-center sm:min-h-[590px] lg:min-h-[680px] lg:grid-cols-[0.72fr_1.28fr]\" data-kid=\"1-2-2-1-4\" data-name=\"viewer content layout\">\n                    <div class=\"order-2 flex h-full flex-col justify-between px-6 pb-8 pt-6 sm:px-10 sm:pb-10 lg:order-1 lg:px-12 lg:py-12\" data-kid=\"1-2-2-1-4-1\" data-name=\"viewer details sidebar\">\n                        <div class=\"flex items-center gap-3 text-[10px] uppercase tracking-[0.28em] text-white/45\" data-kid=\"1-2-2-1-4-1-1\" data-name=\"category label group\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--accent)]\" data-kid=\"1-2-2-1-4-1-1-1\" data-name=\"category label dot\">\n                            </span>\n                            Wedding / Portrait\n                        </div>\n                        <div class=\"mt-8 lg:mt-0\" data-kid=\"1-2-2-1-4-1-2\" data-name=\"frame details group\">\n                            <div class=\"mb-3 flex items-end gap-3\" data-kid=\"1-2-2-1-4-1-2-1\" data-name=\"frame number display group\">\n                                <span class=\"gallery-display text-5xl leading-none text-white sm:text-6xl\" data-dynamic=\"true\" data-kid=\"1-2-2-1-4-1-2-1-1\" data-name=\"current frame number\" data-reason=\"text replaced by gallery navigation script\" id=\"current-number\">\n                                    01\n                                </span>\n                                <span class=\"pb-1 text-xs text-white/35\" data-kid=\"1-2-2-1-4-1-2-1-2\" data-name=\"total frame count\">\n                                    / 14\n                                </span>\n                            </div>\n                            <div class=\"progress-line h-px w-full max-w-[190px]\" data-kid=\"1-2-2-1-4-1-2-2\" data-name=\"progress bar line\">\n                            </div>\n                            <h2 class=\"gallery-display mt-6 max-w-[230px] text-2xl font-normal leading-tight text-white/90\" data-dynamic=\"true\" data-kid=\"1-2-2-1-4-1-2-3\" data-name=\"frame caption text\" data-reason=\"text replaced by gallery navigation script\" id=\"frame-caption\">\n                                A quiet light before the vows.\n                            </h2>\n                            <p class=\"mt-4 max-w-[235px] text-xs leading-6 text-white/45\" data-dynamic=\"true\" data-kid=\"1-2-2-1-4-1-2-4\" data-name=\"frame meta text\" data-reason=\"text replaced by gallery navigation script\" id=\"frame-meta\">\n                                Bridal portrait, captured in the pause before the room fills with music.\n                            </p>\n                        </div>\n                        <div class=\"mt-8 flex items-center justify-between gap-4 lg:mt-0\" data-kid=\"1-2-2-1-4-1-3\" data-name=\"frame utility links\">\n                            <a class=\"frame-link flex items-center gap-2 pb-1 text-[10px] uppercase tracking-[0.24em] text-white/70 no-underline\" data-kid=\"1-2-2-1-4-1-3-1\" data-name=\"full frame link\" href=\"#full-frame\">\n                                <i class=\"h-3.5 w-3.5\" data-dynamic=\"true\" data-kid=\"1-2-2-1-4-1-3-1-1\" data-lucide=\"maximize-2\" data-name=\"maximize icon\" data-reason=\"icon rendered by lucide script\">\n                                </i>\n                                <span data-kid=\"1-2-2-1-4-1-3-1-2\" data-name=\"full frame link text\">\n                                    View full frame\n                                </span>\n                            </a>\n                            <span class=\"text-[9px] uppercase tracking-[0.22em] text-white/30\" data-kid=\"1-2-2-1-4-1-3-2\" data-name=\"frame range label\">\n                                01—14\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"order-1 flex h-full items-center justify-center p-6 sm:p-10 lg:order-2 lg:p-12\" data-kid=\"1-2-2-1-4-2\" data-name=\"stage image container\">\n                        <div class=\"relative flex max-h-full w-full items-center justify-center\" data-kid=\"1-2-2-1-4-2-1\" data-name=\"image wrapper\">\n                            <div class=\"absolute -inset-2 border border-white/10 sm:-inset-4\" data-kid=\"1-2-2-1-4-2-1-1\" data-name=\"image border decoration\">\n                            </div>\n                            <img alt=\"Bridal portrait in warm interior light\" class=\"stage-image relative z-10 max-w-full object-contain\" data-dynamic=\"true\" data-kid=\"1-2-2-1-4-2-1-2\" data-name=\"main stage image\" data-reason=\"src attribute replaced by gallery navigation script\" id=\"stage-image\" src=\"/api/local/images/src/assets/images/gallery/1.jpg\"/>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"absolute bottom-6 right-6 z-20 flex gap-2 sm:bottom-10 sm:right-10\" data-kid=\"1-2-2-1-5\" data-name=\"gallery navigation buttons container\">\n                    <button aria-label=\"Previous frame\" class=\"gallery-control flex h-11 w-11 items-center justify-center rounded-full text-white/75 transition-colors\" data-action=\"prev\" data-kid=\"1-2-2-1-5-1\" data-name=\"previous frame button\" type=\"button\">\n                        <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-2-2-1-5-1-1\" data-lucide=\"arrow-left\" data-name=\"previous arrow icon\" data-reason=\"icon rendered by lucide script\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Next frame\" class=\"gallery-control flex h-11 w-11 items-center justify-center rounded-full text-white/75 transition-colors\" data-action=\"next\" data-kid=\"1-2-2-1-5-2\" data-name=\"next frame button\" type=\"button\">\n                        <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-2-2-1-5-2-1\" data-lucide=\"arrow-right\" data-name=\"next arrow icon\" data-reason=\"icon rendered by lucide script\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Gallery thumbnails\" class=\"mx-auto max-w-[1180px] px-6 pb-20 pt-8 sm:px-10 sm:pb-24 sm:pt-10 lg:px-14\" data-kid=\"1-2-3\" data-name=\"gallery thumbnails section\">\n            <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-2-3-1\" data-name=\"thumbnails header group\">\n                <span class=\"text-[9px] uppercase tracking-[0.3em] text-white/35\" data-kid=\"1-2-3-1-1\" data-name=\"filmstrip label\">\n                    Filmstrip / Contact sheet\n                </span>\n                <span class=\"text-[9px] uppercase tracking-[0.24em] text-white/35\" data-kid=\"1-2-3-1-2\" data-name=\"navigation hint label\">\n                    Swipe to browse\n                </span>\n            </div>\n            <div class=\"filmstrip-scroll flex gap-3 overflow-x-auto pb-2\" data-kid=\"1-2-3-2\" data-name=\"filmstrip scrollable list\">\n                <button aria-label=\"Show frame 1\" class=\"thumb-button is-selected group relative h-24 w-20 shrink-0 overflow-hidden sm:h-28 sm:w-24\" data-caption=\"A quiet light before the vows.\" data-index=\"0\" data-kid=\"1-2-3-2-1\" data-meta=\"Bridal portrait, captured in the pause before the room fills with music.\" data-name=\"frame 1 thumbnail button\" data-src=\"/api/local/images/src/assets/images/gallery/1.jpg\" type=\"button\">\n                    <img alt=\"Frame 1 thumbnail\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-1-1\" data-name=\"frame 1 thumbnail image\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/1.jpg\"/>\n                </button>\n                <button aria-label=\"Show frame 2\" class=\"thumb-button group relative h-24 w-20 shrink-0 overflow-hidden sm:h-28 sm:w-24\" data-caption=\"A face carrying a whole season.\" data-index=\"1\" data-kid=\"1-2-3-2-2\" data-meta=\"Soft light, heirloom detail, and a story still unfolding.\" data-name=\"frame 2 thumbnail button\" data-src=\"/api/local/images/src/assets/images/gallery/2.jpg\" type=\"button\">\n                    <img alt=\"Frame 2 thumbnail\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-2-1\" data-name=\"frame 2 thumbnail image\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/2.jpg\"/>\n                </button>\n                <button aria-label=\"Show frame 3\" class=\"thumb-button group relative h-24 w-20 shrink-0 overflow-hidden sm:h-28 sm:w-24\" data-caption=\"Two lives, held in one frame.\" data-index=\"2\" data-kid=\"1-2-3-2-3\" data-meta=\"A wedding story told in color, contrast, and a little bit of joy.\" data-name=\"frame 3 thumbnail button\" data-src=\"/api/local/images/src/assets/images/gallery/3.jpg\" type=\"button\">\n                    <img alt=\"Frame 3 thumbnail\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-3-1\" data-name=\"frame 3 thumbnail image\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/3.jpg\"/>\n                </button>\n                <button aria-label=\"Show frame 4\" class=\"thumb-button group relative h-24 w-20 shrink-0 overflow-hidden sm:h-28 sm:w-24\" data-caption=\"Details that stay after the music.\" data-index=\"3\" data-kid=\"1-2-3-2-4\" data-meta=\"An editorial portrait in motion, texture, and red silk.\" data-name=\"frame 4 thumbnail button\" data-src=\"/api/local/images/src/assets/images/gallery/4.jpg\" type=\"button\">\n                    <img alt=\"Frame 4 thumbnail\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-4-1\" data-name=\"frame 4 thumbnail image\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/4.jpg\"/>\n                </button>\n                <button aria-label=\"Show frame 5\" class=\"thumb-button group relative h-24 w-20 shrink-0 overflow-hidden sm:h-28 sm:w-24\" data-caption=\"The night opens slowly.\" data-index=\"4\" data-kid=\"1-2-3-2-5\" data-meta=\"A cinematic arrival framed by garden light and long shadows.\" data-name=\"frame 5 thumbnail button\" data-src=\"/api/local/images/src/assets/images/gallery/5.jpg\" type=\"button\">\n                    <img alt=\"Frame 5 thumbnail\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-5-1\" data-name=\"frame 5 thumbnail image\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/5.jpg\"/>\n                </button>\n                <button aria-label=\"Show frame 6\" class=\"thumb-button group relative h-24 w-20 shrink-0 overflow-hidden sm:h-28 sm:w-24\" data-caption=\"A little joy, caught off-script.\" data-index=\"5\" data-kid=\"1-2-3-2-6\" data-meta=\"The frames between the planned frames are often the ones we keep.\" data-name=\"frame 6 thumbnail button\" data-src=\"/api/local/images/src/assets/images/gallery/7.jpg\" type=\"button\">\n                    <img alt=\"Frame 6 thumbnail\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-6-1\" data-name=\"frame 6 thumbnail image\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/7.jpg\"/>\n                </button>\n                <button aria-label=\"Show frame 7\" class=\"thumb-button group relative h-24 w-20 shrink-0 overflow-hidden sm:h-28 sm:w-24\" data-caption=\"Where the light finds you.\" data-index=\"6\" data-kid=\"1-2-3-2-7\" data-meta=\"An editorial study in shape, softness, and a fleeting glance.\" data-name=\"frame 7 thumbnail button\" data-src=\"/api/local/images/src/assets/images/gallery/8.jpg\" type=\"button\">\n                    <img alt=\"Frame 7 thumbnail\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-7-1\" data-name=\"frame 7 thumbnail image\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/8.jpg\"/>\n                </button>\n            </div>\n            <div class=\"mt-8 flex items-center justify-between border-t border-white/10 pt-5 text-[9px] uppercase tracking-[0.28em] text-white/30\" data-kid=\"1-2-3-3\" data-name=\"footer section\">\n                <span data-kid=\"1-2-3-3-1\" data-name=\"copyright notice\">\n                    © Cinemate Production\n                </span>\n                <span data-kid=\"1-2-3-3-2\" data-name=\"footer brand tagline\">\n                    Made for the moments that matter\n                </span>\n            </div>\n        </section>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    (() => {\n    const frames = Array.from(document.querySelectorAll('[data-index]'));\n    const stage = document.getElementById('stage-image');\n    const halo = document.getElementById('halo');\n    const current = document.getElementById('current-number');\n    const caption = document.getElementById('frame-caption');\n    const meta = document.getElementById('frame-meta');\n    let active = 0;\n\n    const render = (index) => {\n      active = (index + frames.length) % frames.length;\n      const frame = frames[active];\n      stage.src = frame.dataset.src;\n      halo.style.backgroundImage = `url('${frame.dataset.src}')`;\n      current.textContent = String(active + 1).padStart(2, '0');\n      caption.textContent = frame.dataset.caption;\n      meta.textContent = frame.dataset.meta;\n      frames.forEach((item, itemIndex) => item.classList.toggle('is-selected', itemIndex === active));\n    };\n\n    frames.forEach((frame, index) => frame.addEventListener('click', () => render(index)));\n    document.querySelector('[data-action=\"prev\"]').addEventListener('click', () => render(active - 1));\n    document.querySelector('[data-action=\"next\"]').addEventListener('click', () => render(active + 1));\n    if (window.lucide) window.lucide.createIcons();\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-10T12:40:36.212506+00:00",
      "modified": "2026-08-10T12:43:05.142044+00:00",
      "id": "var_3fb238de9af4",
      "viewportScrollY": 0
    },
    "var_a540a8ff7041": {
      "type": "variant",
      "label": "Gallery — Contact Sheet Cinema",
