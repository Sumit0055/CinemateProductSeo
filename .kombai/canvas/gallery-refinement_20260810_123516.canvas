        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400;500;600&family=Rubik:wght@300;400;500;600&display=swap');\n  :root {\n    --ink: #171616;\n    --ink-soft: #24201f;\n    --paper: #ded8d1;\n    --paper-muted: #a89f96;\n    --accent: #f62a66;\n    --line: rgba(222,216,209,.18);\n    --line-strong: rgba(222,216,209,.34);\n  }\n  .gallery-cinema * { box-sizing: border-box; }\n  .gallery-cinema { min-height: 100vh; background: var(--ink); color: var(--paper); font-family: 'Rubik', sans-serif; }\n  .display-font { font-family: 'Josefin Sans', sans-serif; }\n  .masthead-word { letter-spacing: .06em; line-height: .79; }\n  .film-thumb.is-active { border-color: var(--accent); background: rgba(246,42,102,.14); }\n  .film-thumb.is-active .film-number { color: var(--accent); }\n  .gallery-stage { min-height: 550px; }\n  .gallery-stage img { max-height: 550px; }\n  .grain { background-image: radial-gradient(rgba(255,255,255,.085) .7px, transparent .7px); background-size: 6px 6px; opacity: .08; pointer-events: none; }\n  @media (max-width: 900px) {\n    .gallery-stage { min-height: 470px; }\n    .gallery-stage img { max-height: 470px; }\n  }\n  @media (max-width: 640px) {\n    .gallery-stage { min-height: 380px; }\n    .gallery-stage img { max-height: 380px; }\n    .masthead-word { font-size: 4.8rem; }\n  }\n</style>\n<div class=\"gallery-cinema min-h-screen overflow-hidden\" data-kid=\"1\" data-name=\"gallery cinema layout\">\n    <header class=\"relative z-20 mx-auto flex max-w-[1180px] items-center justify-between px-6 py-7 lg:px-10\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n        <a aria-label=\"Cinemate Production home\" class=\"group flex items-center gap-3 no-underline\" data-kid=\"1-1-1\" data-name=\"site branding logo link\" href=\"#gallery\">\n            <span class=\"flex h-10 w-10 items-center justify-center border border-[var(--line-strong)] text-[12px] tracking-[.12em] text-[var(--paper)]\" data-kid=\"1-1-1-1\" data-name=\"brand initials logo\">\n                CP\n            </span>\n            <span class=\"leading-none\" data-kid=\"1-1-1-2\" data-name=\"site name text container\">\n                <span class=\"block text-[11px] font-medium uppercase tracking-[.24em] text-[var(--paper)]\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">\n                    Cinemate\n                </span>\n                <span class=\"mt-1 block text-[9px] uppercase tracking-[.25em] text-[var(--paper-muted)]\" data-kid=\"1-1-1-2-2\" data-name=\"brand descriptor text\">\n                    Production\n                </span>\n            </span>\n        </a>\n        <div class=\"hidden items-center gap-8 text-[10px] uppercase tracking-[.24em] text-[var(--paper-muted)] md:flex\" data-kid=\"1-1-2\" data-name=\"navigation links container\">\n            <a class=\"text-[var(--paper)] no-underline\" data-kid=\"1-1-2-1\" data-name=\"gallery link\" href=\"#gallery\">\n                Gallery\n            </a>\n            <a class=\"no-underline hover:text-[var(--paper)]\" data-kid=\"1-1-2-2\" data-name=\"stories link\" href=\"#stories\">\n                Stories\n            </a>\n            <a class=\"no-underline hover:text-[var(--paper)]\" data-kid=\"1-1-2-3\" data-name=\"contact link\" href=\"#contact\">\n                Contact\n            </a>\n        </div>\n        <button aria-label=\"Open menu\" class=\"flex h-11 w-11 items-center justify-center border border-[var(--line-strong)] text-[var(--paper)] hover:border-[var(--accent)] hover:text-[var(--accent)]\" data-kid=\"1-1-3\" data-name=\"mobile menu button\" type=\"button\">\n            <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-1-3-1\" data-lucide=\"menu\" data-name=\"menu hamburger icon\" data-reason=\"svg icon injected by lucide library\">\n            </i>\n        </button>\n    </header>\n    <main class=\"mx-auto max-w-[1180px] px-6 pb-14 lg:px-10 lg:pb-20\" data-kid=\"1-2\" data-name=\"gallery main content section\" id=\"gallery\">\n        <section aria-labelledby=\"gallery-title\" class=\"relative border-t border-[var(--line)] pt-10 lg:pt-12\" data-kid=\"1-2-1\" data-name=\"gallery introduction section\">\n            <div class=\"grain absolute inset-x-0 top-0 h-56\" data-kid=\"1-2-1-1\" data-name=\"decorative grain effect overlay\">\n            </div>\n            <div class=\"relative grid gap-10 lg:grid-cols-[.72fr_1.6fr] lg:items-end lg:gap-16\" data-kid=\"1-2-1-2\" data-name=\"gallery header info container\">\n                <div class=\"pb-1\" data-kid=\"1-2-1-2-1\" data-name=\"gallery title header\">\n                    <p class=\"mb-5 flex items-center gap-3 text-[10px] uppercase tracking-[.3em] text-[var(--accent)]\" data-kid=\"1-2-1-2-1-1\" data-name=\"visual archive header tag\">\n                        <span class=\"h-px w-8 bg-[var(--accent)]\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"accent decorative line\">\n                        </span>\n                        Visual archive / 2024—25\n                    </p>\n                    <h1 class=\"display-font masthead-word m-0 text-[6.7rem] font-light uppercase text-[var(--paper)] sm:text-[8.1rem] lg:text-[9.3rem]\" data-kid=\"1-2-1-2-1-2\" data-name=\"gallery page headline\" id=\"gallery-title\">\n                        Gallery\n                    </h1>\n                    <div class=\"mt-7 max-w-[270px] border-l border-[var(--accent)] pl-4\" data-kid=\"1-2-1-2-1-3\" data-name=\"description text container\">\n                        <p class=\"m-0 text-[13px] leading-6 text-[var(--paper-muted)]\" data-kid=\"1-2-1-2-1-3-1\" data-name=\"gallery description text\">\n                            Frames from celebrations, quiet glances, and the stories we are trusted to keep.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-end justify-between gap-6 pb-1\" data-kid=\"1-2-1-2-2\" data-name=\"metadata information container\">\n                    <p class=\"m-0 max-w-[350px] text-[12px] uppercase leading-5 tracking-[.16em] text-[var(--paper-muted)]\" data-kid=\"1-2-1-2-2-1\" data-name=\"gallery genre labels\">\n                        Indian weddings / fashion editorials / moving portraits\n                    </p>\n                    <p class=\"hidden text-[11px] uppercase tracking-[.22em] text-[var(--paper-muted)] sm:block\" data-kid=\"1-2-1-2-2-2\" data-name=\"scroll prompt text\">\n                        Scroll to explore\n                        <span class=\"ml-2 text-[var(--accent)]\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"arrow icon\">\n                            ↓\n                        </span>\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-12 grid gap-8 lg:mt-14 lg:grid-cols-[46px_1fr] lg:gap-7\" data-kid=\"1-2-2\" data-name=\"gallery interactive showcase section\">\n            <aside aria-label=\"Gallery index\" class=\"hidden flex-col items-center justify-between border-r border-[var(--line)] py-2 lg:flex\" data-kid=\"1-2-2-1\" data-name=\"gallery index sidebar\">\n                <span class=\"writing-mode-vertical rotate-180 text-[10px] uppercase tracking-[.34em] text-[var(--paper-muted)]\" data-kid=\"1-2-2-1-1\" data-name=\"selected frames label\" style=\"writing-mode: vertical-rl;\">\n                    Selected frames\n                </span>\n                <div class=\"flex flex-col items-center gap-5 text-[11px] text-[var(--paper-muted)]\" data-kid=\"1-2-2-1-2\" data-name=\"index number list\">\n                    <span class=\"text-[var(--accent)]\" data-kid=\"1-2-2-1-2-1\" data-name=\"active index number\">\n                        01\n                    </span>\n                    <span data-kid=\"1-2-2-1-2-2\" data-name=\"index number 02\">\n                        02\n                    </span>\n                    <span data-kid=\"1-2-2-1-2-3\" data-name=\"index number 03\">\n                        03\n                    </span>\n                    <span data-kid=\"1-2-2-1-2-4\" data-name=\"index number 04\">\n                        04\n                    </span>\n                    <span data-kid=\"1-2-2-1-2-5\" data-name=\"index number 05\">\n                        05\n                    </span>\n                </div>\n                <span class=\"h-10 w-px bg-[var(--accent)]\" data-kid=\"1-2-2-1-3\" data-name=\"index accent line\">\n                </span>\n            </aside>\n            <div class=\"min-w-0\" data-kid=\"1-2-2-2\" data-name=\"gallery viewport\">\n                <div class=\"grid gap-7 xl:grid-cols-[minmax(0,1fr)_210px]\" data-kid=\"1-2-2-2-1\" data-name=\"main stage layout\">\n                    <div class=\"gallery-stage relative flex items-center justify-center overflow-hidden border border-[var(--line-strong)] bg-[#0e0e0e] p-5 sm:p-8\" data-kid=\"1-2-2-2-1-1\" data-name=\"featured image frame container\">\n                        <div class=\"absolute inset-0 bg-[radial-gradient(circle_at_50%_44%,rgba(255,255,255,.06),transparent_52%)]\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"featured frame gradient overlay\">\n                        </div>\n                        <div class=\"absolute left-5 top-5 z-10 text-[10px] uppercase tracking-[.3em] text-[var(--paper-muted)] sm:left-8 sm:top-8\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"frame counter display\">\n                            Frame\n                            <span class=\"text-[var(--paper)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"current frame counter text\" data-reason=\"text replaced by interactive gallery script\" id=\"frame-counter\">\n                                01\n                            </span>\n                            / 08\n                        </div>\n                        <div class=\"absolute right-5 top-5 z-10 flex items-center gap-2 text-[10px] uppercase tracking-[.2em] text-[var(--paper-muted)] sm:right-8 sm:top-8\" data-kid=\"1-2-2-2-1-1-3\" data-name=\"view frame control\">\n                            <i class=\"h-3.5 w-3.5\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-3-1\" data-lucide=\"expand\" data-name=\"expand icon\" data-reason=\"svg icon injected by lucide library\">\n                            </i>\n                            View frame\n                        </div>\n                        <div class=\"relative z-10 flex h-full w-full items-center justify-center\" data-kid=\"1-2-2-2-1-1-4\" data-name=\"image wrapper\">\n                            <img alt=\"Bride in a coral sari, captured in warm interior light\" class=\"block h-auto w-auto max-w-full object-contain shadow-[0_18px_60px_rgba(0,0,0,.45)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-4-1\" data-name=\"main featured image\" data-reason=\"src and alt attributes replaced by interactive gallery script\" id=\"main-frame\" src=\"/api/local/images/src/assets/images/gallery/1.jpg\"/>\n                        </div>\n                        <div class=\"grain absolute inset-0\" data-kid=\"1-2-2-2-1-1-5\" data-name=\"featured image grain effect\">\n                        </div>\n                        <button aria-label=\"Previous frame\" class=\"absolute bottom-5 left-5 z-20 flex h-10 w-10 items-center justify-center border border-[var(--line-strong)] bg-[rgba(23,22,22,.8)] text-[var(--paper)] hover:border-[var(--accent)] hover:text-[var(--accent)] sm:bottom-8 sm:left-8\" data-kid=\"1-2-2-2-1-1-6\" data-name=\"previous frame button\" id=\"prev-frame\" type=\"button\">\n                            <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-6-1\" data-lucide=\"arrow-left\" data-name=\"previous arrow icon\" data-reason=\"svg icon injected by lucide library\">\n                            </i>\n                        </button>\n                        <button aria-label=\"Next frame\" class=\"absolute bottom-5 right-5 z-20 flex h-10 w-10 items-center justify-center border border-[var(--line-strong)] bg-[rgba(23,22,22,.8)] text-[var(--paper)] hover:border-[var(--accent)] hover:text-[var(--accent)] sm:bottom-8 sm:right-8\" data-kid=\"1-2-2-2-1-1-7\" data-name=\"next frame button\" id=\"next-frame\" type=\"button\">\n                            <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-7-1\" data-lucide=\"arrow-right\" data-name=\"next arrow icon\" data-reason=\"svg icon injected by lucide library\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"flex flex-col justify-end xl:pb-2\" data-kid=\"1-2-2-2-1-2\" data-name=\"frame details container\">\n                        <div class=\"mb-8 border-b border-[var(--line)] pb-7\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"frame information\">\n                            <p class=\"mb-3 text-[10px] uppercase tracking-[.27em] text-[var(--accent)]\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"portfolio note label\">\n                                Portfolio note\n                            </p>\n                            <h2 class=\"display-font m-0 text-3xl font-light leading-tight text-[var(--paper)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"current frame title\" data-reason=\"text replaced by interactive gallery script\" id=\"frame-title\">\n                                A quiet beginning\n                            </h2>\n                            <p class=\"mt-4 text-[12px] leading-6 text-[var(--paper-muted)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-1-3\" data-name=\"current frame description\" data-reason=\"text replaced by interactive gallery script\" id=\"frame-caption\">\n                                Soft light, heirloom details, and the pause before a room fills with music.\n                            </p>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-3 text-[10px] uppercase tracking-[.22em] text-[var(--paper-muted)]\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"frame metadata bar\">\n                            <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"camera metadata\">\n                                <i class=\"h-3.5 w-3.5 text-[var(--accent)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-2-1-1\" data-lucide=\"camera\" data-name=\"camera icon\" data-reason=\"svg icon injected by lucide library\">\n                                </i>\n                                Still / 01\n                            </span>\n                            <span data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"location metadata\">\n                                Delhi NCR\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div aria-label=\"Film contact sheet\" class=\"mt-8 border-t border-[var(--line-strong)] pt-5\" data-kid=\"1-2-2-2-2\" data-name=\"film strip section\">\n                    <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-2-2-2-2-1\" data-name=\"film strip header\">\n                        <div class=\"flex items-center gap-3 text-[10px] uppercase tracking-[.3em] text-[var(--paper-muted)]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"contact sheet label\">\n                            <span class=\"h-px w-6 bg-[var(--accent)]\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"contact sheet line\">\n                            </span>\n                            Contact sheet\n                        </div>\n                        <span class=\"text-[10px] uppercase tracking-[.22em] text-[var(--paper-muted)]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"film strip instructions\">\n                            Select a frame\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-4 gap-2 sm:grid-cols-8 sm:gap-3\" data-kid=\"1-2-2-2-2-2\" data-name=\"film strip thumbnails\" id=\"film-strip\">\n                        <button aria-label=\"Show frame 1\" class=\"film-thumb is-active group border border-[var(--accent)] bg-[rgba(246,42,102,.14)] p-1 text-left\" data-caption=\"Soft light, heirloom details, and the pause before a room fills with music.\" data-dynamic=\"true\" data-image=\"1.jpg\" data-index=\"0\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"thumbnail 1\" data-reason=\"classes changed by gallery script to indicate active state\" data-title=\"A quiet beginning\" type=\"button\">\n                            <span class=\"relative block aspect-[4/3] overflow-hidden bg-[var(--ink-soft)]\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"thumb 1 image container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover opacity-90 group-hover:opacity-100\" data-kid=\"1-2-2-2-2-2-1-1-1\" data-name=\"thumb 1 image\" src=\"/api/local/images/src/assets/images/gallery/1.jpg\"/>\n                            </span>\n                            <span class=\"film-number mt-2 block text-[10px] tracking-[.2em] text-[var(--accent)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"thumb 1 number\" data-reason=\"classes changed by gallery script to indicate active state\">\n                                01\n                            </span>\n                        </button>\n                        <button aria-label=\"Show frame 2\" class=\"film-thumb group border border-[var(--line)] bg-[var(--ink-soft)] p-1 text-left hover:border-[var(--line-strong)]\" data-caption=\"A portrait held in the warm hush of a room before the ceremony begins.\" data-dynamic=\"true\" data-image=\"2.jpg\" data-index=\"1\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"thumbnail 2\" data-reason=\"classes changed by gallery script\" data-title=\"Before the vows\" type=\"button\">\n                            <span class=\"relative block aspect-[4/3] overflow-hidden\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"thumb 2 image container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover opacity-75 group-hover:opacity-100\" data-kid=\"1-2-2-2-2-2-2-1-1\" data-name=\"thumb 2 image\" src=\"/api/local/images/src/assets/images/gallery/2.jpg\"/>\n                            </span>\n                            <span class=\"film-number mt-2 block text-[10px] tracking-[.2em] text-[var(--paper-muted)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"thumb 2 number\" data-reason=\"classes changed by gallery script\">\n                                02\n                            </span>\n                        </button>\n                        <button aria-label=\"Show frame 3\" class=\"film-thumb group border border-[var(--line)] bg-[var(--ink-soft)] p-1 text-left hover:border-[var(--line-strong)]\" data-caption=\"A layered wedding-day study in color, texture, and the people around it.\" data-dynamic=\"true\" data-image=\"3.jpg\" data-index=\"2\" data-kid=\"1-2-2-2-2-2-3\" data-name=\"thumbnail 3\" data-reason=\"classes changed by gallery script\" data-title=\"Two stories, one frame\" type=\"button\">\n                            <span class=\"relative block aspect-[4/3] overflow-hidden\" data-kid=\"1-2-2-2-2-2-3-1\" data-name=\"thumb 3 image container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover opacity-75 group-hover:opacity-100\" data-kid=\"1-2-2-2-2-2-3-1-1\" data-name=\"thumb 3 image\" src=\"/api/local/images/src/assets/images/gallery/3.jpg\"/>\n                            </span>\n                            <span class=\"film-number mt-2 block text-[10px] tracking-[.2em] text-[var(--paper-muted)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-3-2\" data-name=\"thumb 3 number\" data-reason=\"classes changed by gallery script\">\n                                03\n                            </span>\n                        </button>\n                        <button aria-label=\"Show frame 4\" class=\"film-thumb group border border-[var(--line)] bg-[var(--ink-soft)] p-1 text-left hover:border-[var(--line-strong)]\" data-caption=\"Editorial calm, embroidered detail, and a fleeting glance over the shoulder.\" data-dynamic=\"true\" data-image=\"4.jpg\" data-index=\"3\" data-kid=\"1-2-2-2-2-2-4\" data-name=\"thumbnail 4\" data-reason=\"classes changed by gallery script\" data-title=\"The in-between glance\" type=\"button\">\n                            <span class=\"relative block aspect-[4/3] overflow-hidden\" data-kid=\"1-2-2-2-2-2-4-1\" data-name=\"thumb 4 image container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover opacity-75 group-hover:opacity-100\" data-kid=\"1-2-2-2-2-2-4-1-1\" data-name=\"thumb 4 image\" src=\"/api/local/images/src/assets/images/gallery/4.jpg\"/>\n                            </span>\n                            <span class=\"film-number mt-2 block text-[10px] tracking-[.2em] text-[var(--paper-muted)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-4-2\" data-name=\"thumb 4 number\" data-reason=\"classes changed by gallery script\">\n                                04\n                            </span>\n                        </button>\n                        <button aria-label=\"Show frame 5\" class=\"film-thumb group border border-[var(--line)] bg-[var(--ink-soft)] p-1 text-left hover:border-[var(--line-strong)]\" data-caption=\"A cinematic walk through shadow, foliage, and the glow of an evening celebration.\" data-dynamic=\"true\" data-image=\"5.jpg\" data-index=\"4\" data-kid=\"1-2-2-2-2-2-5\" data-name=\"thumbnail 5\" data-reason=\"classes changed by gallery script\" data-title=\"Under the garden lights\" type=\"button\">\n                            <span class=\"relative block aspect-[4/3] overflow-hidden\" data-kid=\"1-2-2-2-2-2-5-1\" data-name=\"thumb 5 image container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover opacity-75 group-hover:opacity-100\" data-kid=\"1-2-2-2-2-2-5-1-1\" data-name=\"thumb 5 image\" src=\"/api/local/images/src/assets/images/gallery/5.jpg\"/>\n                            </span>\n                            <span class=\"film-number mt-2 block text-[10px] tracking-[.2em] text-[var(--paper-muted)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-5-2\" data-name=\"thumb 5 number\" data-reason=\"classes changed by gallery script\">\n                                05\n                            </span>\n                        </button>\n                        <button aria-label=\"Show frame 6\" class=\"film-thumb group border border-[var(--line)] bg-[var(--ink-soft)] p-1 text-left hover:border-[var(--line-strong)]\" data-caption=\"The generous color and quiet energy that make a celebration feel entirely yours.\" data-dynamic=\"true\" data-image=\"7.jpg\" data-index=\"5\" data-kid=\"1-2-2-2-2-2-6\" data-name=\"thumbnail 6\" data-reason=\"classes changed by gallery script\" data-title=\"After the applause\" type=\"button\">\n                            <span class=\"relative block aspect-[4/3] overflow-hidden\" data-kid=\"1-2-2-2-2-2-6-1\" data-name=\"thumb 6 image container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover opacity-75 group-hover:opacity-100\" data-kid=\"1-2-2-2-2-2-6-1-1\" data-name=\"thumb 6 image\" src=\"/api/local/images/src/assets/images/gallery/7.jpg\"/>\n                            </span>\n                            <span class=\"film-number mt-2 block text-[10px] tracking-[.2em] text-[var(--paper-muted)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-6-2\" data-name=\"thumb 6 number\" data-reason=\"classes changed by gallery script\">\n                                06\n                            </span>\n                        </button>\n                        <button aria-label=\"Show frame 7\" class=\"film-thumb group border border-[var(--line)] bg-[var(--ink-soft)] p-1 text-left hover:border-[var(--line-strong)]\" data-caption=\"An editorial frame built from movement, negative space, and considered light.\" data-dynamic=\"true\" data-image=\"8.jpg\" data-index=\"6\" data-kid=\"1-2-2-2-2-2-7\" data-name=\"thumbnail 7\" data-reason=\"classes changed by gallery script\" data-title=\"A room of its own\" type=\"button\">\n                            <span class=\"relative block aspect-[4/3] overflow-hidden\" data-kid=\"1-2-2-2-2-2-7-1\" data-name=\"thumb 7 image container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover opacity-75 group-hover:opacity-100\" data-kid=\"1-2-2-2-2-2-7-1-1\" data-name=\"thumb 7 image\" src=\"/api/local/images/src/assets/images/gallery/8.jpg\"/>\n                            </span>\n                            <span class=\"film-number mt-2 block text-[10px] tracking-[.2em] text-[var(--paper-muted)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-7-2\" data-name=\"thumb 7 number\" data-reason=\"classes changed by gallery script\">\n                                07\n                            </span>\n                        </button>\n                        <button aria-label=\"Show frame 8\" class=\"film-thumb group border border-[var(--line)] bg-[var(--ink-soft)] p-1 text-left hover:border-[var(--line-strong)]\" data-caption=\"One final still to carry the feeling forward, long after the day is over.\" data-dynamic=\"true\" data-image=\"1.jpg\" data-index=\"7\" data-kid=\"1-2-2-2-2-2-8\" data-name=\"thumbnail 8\" data-reason=\"classes changed by gallery script\" data-title=\"The signature frame\" type=\"button\">\n                            <span class=\"relative block aspect-[4/3] overflow-hidden\" data-kid=\"1-2-2-2-2-2-8-1\" data-name=\"thumb 8 image container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover opacity-75 group-hover:opacity-100\" data-kid=\"1-2-2-2-2-2-8-1-1\" data-name=\"thumb 8 image\" src=\"/api/local/images/src/assets/images/gallery/1.jpg\"/>\n                            </span>\n                            <span class=\"film-number mt-2 block text-[10px] tracking-[.2em] text-[var(--paper-muted)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-8-2\" data-name=\"thumb 8 number\" data-reason=\"classes changed by gallery script\">\n                                08\n                            </span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"mx-auto flex max-w-[1180px] flex-col gap-4 border-t border-[var(--line)] px-6 py-7 text-[10px] uppercase tracking-[.24em] text-[var(--paper-muted)] sm:flex-row sm:items-center sm:justify-between lg:px-10\" data-kid=\"1-3\" data-name=\"footer section\">\n        <span data-kid=\"1-3-1\" data-name=\"copyright notice text\">\n            © 2025 Cinemate Production\n        </span>\n        <span data-kid=\"1-3-2\" data-name=\"footer tagline\">\n            Stories, composed with care\n            <span class=\"text-[var(--accent)]\" data-kid=\"1-3-2-1\" data-name=\"decorative separator\">\n                —\n            </span>\n        </span>\n    </footer>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    const frameData = Array.from(document.querySelectorAll('.film-thumb')).map((button, index) => ({\n    index,\n    image: button.dataset.image,\n    title: button.dataset.title,\n    caption: button.dataset.caption,\n  }));\n  const mainFrame = document.getElementById('main-frame');\n  const frameCounter = document.getElementById('frame-counter');\n  const frameTitle = document.getElementById('frame-title');\n  const frameCaption = document.getElementById('frame-caption');\n  const thumbs = Array.from(document.querySelectorAll('.film-thumb'));\n  let current = 0;\n  function showFrame(next) {\n    current = (next + frameData.length) % frameData.length;\n    const frame = frameData[current];\n    mainFrame.src = '/api/local/images/src/assets/images/gallery/' + frame.image;\n    mainFrame.alt = frame.title;\n    frameCounter.textContent = String(current + 1).padStart(2, '0');\n    frameTitle.textContent = frame.title;\n    frameCaption.textContent = frame.caption;\n    thumbs.forEach((thumb, index) => {\n      thumb.classList.toggle('is-active', index === current);\n      thumb.classList.toggle('border-[var(--accent)]', index === current);\n      thumb.classList.toggle('bg-[rgba(246,42,102,.14)]', index === current);\n      thumb.classList.toggle('border-[var(--line)]', index !== current);\n      thumb.classList.toggle('bg-[var(--ink-soft)]', index !== current);\n      const number = thumb.querySelector('.film-number');\n      if (number) number.classList.toggle('text-[var(--accent)]', index === current);\n      if (number) number.classList.toggle('text-[var(--paper-muted)]', index !== current);\n    });\n  }\n  thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => showFrame(index)));\n  document.getElementById('prev-frame').addEventListener('click', () => showFrame(current - 1));\n  document.getElementById('next-frame').addEventListener('click', () => showFrame(current + 1));\n  if (window.lucide) window.lucide.createIcons();\n</script>\n",
