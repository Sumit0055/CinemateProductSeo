      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;500;600;700&family=Rubik:wght@300;400;500;600&display=swap');\n  :root { --cream: #f5f1eb; --paper: #fbf8f3; --ink: #181614; --muted: #8e857b; --line: #ded7cf; --accent: #f62a66; }\n  body { margin: 0; background: var(--cream); color: var(--ink); font-family: 'Rubik', sans-serif; }\n  .gallery-shell { min-height: 100vh; overflow: hidden; background: var(--cream); }\n  .gallery-shell::before { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .28; background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.08'/%3E%3C/svg%3E\"); mix-blend-mode: multiply; z-index: 10; }\n  .display { font-family: 'Josefin Sans', sans-serif; }\n  .frame-shadow { box-shadow: 0 22px 60px rgba(41, 31, 24, .13), 0 3px 12px rgba(41, 31, 24, .08); }\n  .thumb-button { position: relative; display: block; overflow: hidden; background: #ded7cf; }\n  .thumb-button::after { content: ''; position: absolute; inset: 0; border: 2px solid transparent; transition: border-color .2s ease, background .2s ease; }\n  .thumb-button.is-active::after { border-color: var(--accent); box-shadow: inset 0 0 0 3px rgba(255,255,255,.8); }\n  .thumb-button:not(.is-active):hover::after { border-color: rgba(246,42,102,.55); }\n  .thumb-button img { transition: transform .35s ease, opacity .35s ease; }\n  .thumb-button:hover img { transform: scale(1.05); opacity: .9; }\n  .thin-rule { height: 1px; background: var(--line); }\n  .progress-track { height: 2px; background: #d5ccc3; }\n  .progress-fill { height: 2px; width: 7.14%; background: var(--accent); }\n  @media (max-width: 900px) {\n    .gallery-main-grid { grid-template-columns: 1fr; }\n    .gallery-copy { order: -1; }\n    .gallery-stage { min-height: 560px; }\n    .gallery-side { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: end; }\n  }\n  @media (max-width: 560px) {\n    .gallery-header { padding: 22px 20px; }\n    .gallery-content { padding: 46px 20px 34px; }\n    .gallery-stage { min-height: 470px; padding: 20px; }\n    .gallery-side { display: block; }\n    .gallery-copy h1 { font-size: 3.25rem; line-height: .94; }\n    .thumb-rail { gap: 8px; }\n    .thumb-button { min-width: 76px; }\n  }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"gallery-shell\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"gallery-header relative z-20 mx-auto flex max-w-[1160px] items-center justify-between border-b border-[#ded7cf] px-8 py-7\" data-kid=\"1-1\" data-name=\"site header\">\n        <a aria-label=\"Cinemate Production home\" class=\"group no-underline\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\">\n            <span class=\"display block text-[17px] font-semibold leading-[.84] tracking-[.22em] text-[#181614]\" data-kid=\"1-1-1-1\" data-name=\"brand name text\">\n                CINE\n                <br data-kid=\"1-1-1-1-1\" data-name=\"brand name line break\"/>\n                MATE\n            </span>\n            <span class=\"mt-2 block text-[8px] uppercase tracking-[.34em] text-[#8e857b]\" data-kid=\"1-1-1-2\" data-name=\"brand subtitle text\">\n                Production\n            </span>\n        </a>\n        <div class=\"hidden items-center gap-10 md:flex\" data-kid=\"1-1-2\" data-name=\"navigation container\">\n            <span class=\"text-[10px] uppercase tracking-[.28em] text-[#8e857b]\" data-kid=\"1-1-2-1\" data-name=\"portfolio year indicator\">\n                Portfolio / 2024—25\n            </span>\n            <nav aria-label=\"Primary\" class=\"flex items-center gap-8 text-[11px] uppercase tracking-[.18em] text-[#181614]\" data-kid=\"1-1-2-2\" data-name=\"primary navigation links\">\n                <a class=\"no-underline hover:text-[#f62a66]\" data-kid=\"1-1-2-2-1\" data-name=\"gallery link\" href=\"#gallery\">\n                    Gallery\n                </a>\n                <a class=\"no-underline hover:text-[#f62a66]\" data-kid=\"1-1-2-2-2\" data-name=\"about link\" href=\"#about\">\n                    About\n                </a>\n                <a class=\"no-underline hover:text-[#f62a66]\" data-kid=\"1-1-2-2-3\" data-name=\"contact link\" href=\"#contact\">\n                    Contact\n                </a>\n            </nav>\n        </div>\n        <button aria-label=\"Open menu\" class=\"flex h-10 w-10 items-center justify-center rounded-full border border-[#ded7cf] bg-transparent text-[#181614] md:hidden\" data-kid=\"1-1-3\" data-name=\"mobile menu button\">\n            <i class=\"h-[17px] w-[17px]\" data-kid=\"1-1-3-1\" data-lucide=\"menu\" data-name=\"menu hamburger icon\">\n            </i>\n        </button>\n    </header>\n    <main class=\"gallery-content relative z-0 mx-auto max-w-[1160px] px-8 pb-20 pt-[72px]\" data-kid=\"1-2\" data-name=\"main gallery content\" id=\"gallery\">\n        <div class=\"mb-12 grid grid-cols-[1fr_auto] items-end gap-8 border-b border-[#ded7cf] pb-9 md:grid-cols-[1fr_280px]\" data-kid=\"1-2-1\" data-name=\"gallery header area\">\n            <div class=\"gallery-copy max-w-[700px]\" data-kid=\"1-2-1-1\" data-name=\"gallery copy container\">\n                <div class=\"mb-5 flex items-center gap-3 text-[10px] uppercase tracking-[.3em] text-[#f62a66]\" data-kid=\"1-2-1-1-1\" data-name=\"featured status tag\">\n                    <span class=\"h-[6px] w-[6px] rounded-full bg-[#f62a66]\" data-kid=\"1-2-1-1-1-1\" data-name=\"status dot\">\n                    </span>\n                    Selected frames\n                </div>\n                <h1 class=\"display m-0 max-w-[690px] text-[76px] font-medium leading-[.93] tracking-[-.045em] text-[#181614]\" data-kid=\"1-2-1-1-2\" data-name=\"gallery headline\">\n                    Frames from the\n                    <br data-kid=\"1-2-1-1-2-1\" data-name=\"headline line break\"/>\n                    <em class=\"font-normal text-[#8e857b]\" data-kid=\"1-2-1-1-2-2\" data-name=\"italic headline highlight\">\n                        moments\n                    </em>\n                    that matter.\n                </h1>\n            </div>\n            <p class=\"mb-1 max-w-[255px] text-[13px] font-light leading-[1.75] text-[#746b63]\" data-kid=\"1-2-1-2\" data-name=\"gallery intro description\">\n                A quiet collection of wedding, editorial, and fashion stories — photographed with feeling, light, and a little patience.\n            </p>\n        </div>\n        <div class=\"gallery-main-grid grid grid-cols-[minmax(0,1fr)_300px] items-center gap-16\" data-kid=\"1-2-2\" data-name=\"gallery main grid container\">\n            <section aria-label=\"Featured gallery frame\" class=\"gallery-stage relative flex min-h-[600px] items-center justify-center bg-[#ebe4dc] px-12 py-10\" data-kid=\"1-2-2-1\" data-name=\"featured image frame container\">\n                <div class=\"absolute left-6 top-6 flex items-center gap-3 text-[10px] uppercase tracking-[.24em] text-[#8e857b]\" data-kid=\"1-2-2-1-1\" data-name=\"frame metadata container\">\n                    <i class=\"h-3 w-3\" data-kid=\"1-2-2-1-1-1\" data-lucide=\"camera\" data-name=\"camera icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-1-1-2\" data-name=\"frame metadata label\">\n                        Featured frame\n                    </span>\n                </div>\n                <button aria-label=\"Previous frame\" class=\"absolute left-5 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-[#cfc5ba] bg-[#f8f4ef]/85 text-[#181614] backdrop-blur-sm hover:border-[#f62a66] hover:text-[#f62a66]\" data-kid=\"1-2-2-1-2\" data-name=\"previous frame button\" id=\"prev-frame\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-2-1-2-1\" data-lucide=\"arrow-left\" data-name=\"left arrow icon\">\n                    </i>\n                </button>\n                <div class=\"relative bg-[#fbf8f3] p-[14px] frame-shadow\" data-kid=\"1-2-2-1-3\" data-name=\"image display wrapper\">\n                    <img alt=\"Bride in a coral sari, framed in warm interior light\" class=\"block h-[550px] w-auto max-w-[min(66vw,440px)] object-contain\" data-dynamic=\"true\" data-kid=\"1-2-2-1-3-1\" data-name=\"main gallery image\" data-reason=\"src and alt replaced by script on gallery navigation\" decoding=\"async\" id=\"main-frame\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/1.jpg\"/>\n                    <div class=\"pointer-events-none absolute inset-x-[14px] bottom-[14px] h-20 bg-gradient-to-t from-black/15 to-transparent\" data-kid=\"1-2-2-1-3-2\" data-name=\"image gradient overlay\">\n                    </div>\n                </div>\n                <button aria-label=\"Next frame\" class=\"absolute right-5 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-[#cfc5ba] bg-[#f8f4ef]/85 text-[#181614] backdrop-blur-sm hover:border-[#f62a66] hover:text-[#f62a66]\" data-kid=\"1-2-2-1-4\" data-name=\"next frame button\" id=\"next-frame\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-2-1-4-1\" data-lucide=\"arrow-right\" data-name=\"right arrow icon\">\n                    </i>\n                </button>\n                <div class=\"absolute bottom-6 right-6 flex items-center gap-2 text-[10px] uppercase tracking-[.22em] text-[#8e857b]\" data-kid=\"1-2-2-1-5\" data-name=\"full frame view container\">\n                    <i class=\"h-3 w-3\" data-kid=\"1-2-2-1-5-1\" data-lucide=\"maximize-2\" data-name=\"maximize icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-1-5-2\" data-name=\"view full frame label\">\n                        View full frame\n                    </span>\n                </div>\n            </section>\n            <aside aria-live=\"polite\" class=\"gallery-side flex flex-col justify-between self-stretch py-5\" data-kid=\"1-2-2-2\" data-name=\"frame details sidebar\">\n                <div data-kid=\"1-2-2-2-1\" data-name=\"frame text details container\">\n                    <div class=\"mb-8 flex items-end justify-between border-b border-[#ded7cf] pb-4\" data-kid=\"1-2-2-2-1-1\" data-name=\"frame index container\">\n                        <span class=\"display text-[50px] font-medium leading-none tracking-[-.05em]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"current frame index number\" data-reason=\"text replaced by script on gallery navigation\" id=\"frame-index\">\n                            01\n                        </span>\n                        <span class=\"mb-1 text-[12px] tracking-[.1em] text-[#8e857b]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"total frame count\">\n                            / 14\n                        </span>\n                    </div>\n                    <div class=\"mb-6 flex items-center gap-2 text-[10px] uppercase tracking-[.26em] text-[#f62a66]\" data-kid=\"1-2-2-2-1-2\" data-name=\"frame category label container\">\n                        <i class=\"h-3 w-3 fill-[#f62a66]\" data-kid=\"1-2-2-2-1-2-1\" data-lucide=\"heart\" data-name=\"heart icon\">\n                        </i>\n                        <span data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"current frame category\" data-reason=\"text replaced by script on gallery navigation\" id=\"frame-category\">\n                            Wedding stories\n                        </span>\n                    </div>\n                    <h2 class=\"display mb-4 text-[30px] font-medium leading-[1.05] tracking-[-.03em]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-3\" data-name=\"current frame title\" data-reason=\"text replaced by script on gallery navigation\" id=\"frame-title\">\n                        A study in\n                        <br data-kid=\"1-2-2-2-1-3-1\" data-name=\"title line break\"/>\n                        soft light.\n                    </h2>\n                    <p class=\"max-w-[250px] text-[13px] font-light leading-[1.8] text-[#746b63]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-4\" data-name=\"current frame description text\" data-reason=\"text replaced by script on gallery navigation\" id=\"frame-caption\">\n                        The in-between moments are often the ones that stay with us longest.\n                    </p>\n                </div>\n                <div class=\"mt-10\" data-kid=\"1-2-2-2-2\" data-name=\"archive note container\">\n                    <div class=\"mb-3 flex items-center justify-between text-[10px] uppercase tracking-[.2em] text-[#8e857b]\" data-kid=\"1-2-2-2-2-1\" data-name=\"archive note label container\">\n                        <span data-kid=\"1-2-2-2-2-1-1\" data-name=\"archive note label\">\n                            Archive note\n                        </span>\n                        <i class=\"h-3 w-3\" data-kid=\"1-2-2-2-2-1-2\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                        </i>\n                    </div>\n                    <div class=\"thin-rule mb-5\" data-kid=\"1-2-2-2-2-2\" data-name=\"archive note separator rule\">\n                    </div>\n                    <p class=\"m-0 text-[11px] leading-[1.7] text-[#8e857b]\" data-kid=\"1-2-2-2-2-3\" data-name=\"location capture text\">\n                        Delhi NCR · India\n                        <br data-kid=\"1-2-2-2-2-3-1\" data-name=\"location line break\"/>\n                        Captured on location\n                    </p>\n                </div>\n            </aside>\n        </div>\n        <div class=\"mt-12 border-t border-[#ded7cf] pt-6\" data-kid=\"1-2-3\" data-name=\"thumbnail navigation area\">\n            <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-2-3-1\" data-name=\"thumbnail header container\">\n                <div class=\"flex items-center gap-3 text-[10px] uppercase tracking-[.26em] text-[#8e857b]\" data-kid=\"1-2-3-1-1\" data-name=\"story browse label container\">\n                    <span class=\"text-[#181614]\" data-kid=\"1-2-3-1-1-1\" data-name=\"browse story label\">\n                        Browse the story\n                    </span>\n                    <span class=\"h-px w-8 bg-[#f62a66]\" data-kid=\"1-2-3-1-1-2\" data-name=\"story progress separator\">\n                    </span>\n                    <span data-kid=\"1-2-3-1-1-3\" data-name=\"story range indicator\">\n                        01—08\n                    </span>\n                </div>\n                <span class=\"hidden text-[10px] uppercase tracking-[.2em] text-[#8e857b] sm:block\" data-kid=\"1-2-3-1-2\" data-name=\"thumbnail helper text\">\n                    Select a frame to explore\n                </span>\n            </div>\n            <div aria-label=\"Gallery thumbnails\" class=\"thumb-rail flex gap-3 overflow-x-auto pb-2\" data-kid=\"1-2-3-2\" data-name=\"gallery thumbnails\" role=\"listbox\">\n                <button aria-label=\"Show frame 01\" aria-selected=\"true\" class=\"thumb-button is-active h-[104px] min-w-[126px] flex-1\" data-alt=\"Bride in a coral sari, framed in warm interior light\" data-caption=\"The in-between moments are often the ones that stay with us longest.\" data-category=\"Wedding stories\" data-dynamic=\"true\" data-index=\"0\" data-kid=\"1-2-3-2-1\" data-name=\"gallery thumbnail button\" data-reason=\"active state and aria attributes toggled by script\" data-title=\"A study in soft light.\">\n                    <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-1-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/1.jpg\"/>\n                </button>\n                <button aria-label=\"Show frame 02\" aria-selected=\"false\" class=\"thumb-button h-[104px] min-w-[126px] flex-1\" data-caption=\"A breath, a glance, and the calm before a room fills with celebration.\" data-category=\"Bridal portrait\" data-dynamic=\"true\" data-index=\"1\" data-kid=\"1-2-3-2-2\" data-name=\"gallery thumbnail button\" data-reason=\"active state and aria attributes toggled by script\" data-title=\"Before the music begins.\">\n                    <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-2-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/2.jpg\"/>\n                </button>\n                <button aria-label=\"Show frame 03\" aria-selected=\"false\" class=\"thumb-button h-[104px] min-w-[126px] flex-1\" data-caption=\"A little chaos around the edges; all the tenderness in the middle.\" data-category=\"Wedding stories\" data-dynamic=\"true\" data-index=\"2\" data-kid=\"1-2-3-2-3\" data-name=\"gallery thumbnail button\" data-reason=\"active state and aria attributes toggled by script\" data-title=\"Two lives, one frame.\">\n                    <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-3-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/3.jpg\"/>\n                </button>\n                <button aria-label=\"Show frame 04\" aria-selected=\"false\" class=\"thumb-button h-[104px] min-w-[126px] flex-1\" data-caption=\"Texture, gesture, and the quiet architecture of getting ready.\" data-category=\"Editorial portrait\" data-dynamic=\"true\" data-index=\"3\" data-kid=\"1-2-3-2-4\" data-name=\"gallery thumbnail button\" data-reason=\"active state and aria attributes toggled by script\" data-title=\"Details worth remembering.\">\n                    <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-4-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/4.jpg\"/>\n                </button>\n                <button aria-label=\"Show frame 05\" aria-selected=\"false\" class=\"thumb-button h-[104px] min-w-[126px] flex-1\" data-caption=\"A cinematic walk through the last light of the evening.\" data-category=\"Wedding stories\" data-dynamic=\"true\" data-index=\"4\" data-kid=\"1-2-3-2-5\" data-name=\"gallery thumbnail button\" data-reason=\"active state and aria attributes toggled by script\" data-title=\"Night falls softly.\">\n                    <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-5-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/5.jpg\"/>\n                </button>\n                <button aria-label=\"Show frame 06\" aria-selected=\"false\" class=\"thumb-button h-[104px] min-w-[126px] flex-1\" data-caption=\"Movement, color, and the shape of a story still finding its ending.\" data-category=\"Fashion story\" data-dynamic=\"true\" data-index=\"5\" data-kid=\"1-2-3-2-6\" data-name=\"gallery thumbnail button\" data-reason=\"active state and aria attributes toggled by script\" data-title=\"A frame between frames.\">\n                    <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-6-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/7.jpg\"/>\n                </button>\n                <button aria-label=\"Show frame 07\" aria-selected=\"false\" class=\"thumb-button h-[104px] min-w-[126px] flex-1\" data-caption=\"The smallest details carry the most character.\" data-category=\"Editorial portrait\" data-dynamic=\"true\" data-index=\"6\" data-kid=\"1-2-3-2-7\" data-name=\"gallery thumbnail button\" data-reason=\"active state and aria attributes toggled by script\" data-title=\"Held in the light.\">\n                    <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-7-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/images/gallery/8.jpg\"/>\n                </button>\n            </div>\n            <div class=\"progress-track mt-5\" data-kid=\"1-2-3-3\" data-name=\"progress bar track\">\n                <div class=\"progress-fill\" data-dynamic=\"true\" data-kid=\"1-2-3-3-1\" data-name=\"progress bar fill\" data-reason=\"width updated by script on gallery navigation\" id=\"progress-fill\">\n                </div>\n            </div>\n        </div>\n    </main>\n    <footer class=\"relative z-20 mx-auto flex max-w-[1160px] items-center justify-between border-t border-[#ded7cf] px-8 py-7 text-[10px] uppercase tracking-[.2em] text-[#8e857b]\" data-kid=\"1-3\" data-name=\"page footer\">\n        <span data-kid=\"1-3-1\" data-name=\"copyright notice text\">\n            © Cinemate Production\n        </span>\n        <span data-kid=\"1-3-2\" data-name=\"footer description text\">\n            Stories in stills & motion\n        </span>\n        <span class=\"hidden sm:block\" data-kid=\"1-3-3\" data-name=\"scroll instruction text\">\n            Scroll to continue ↓\n        </span>\n    </footer>\n</div>\n<script>\n    const frames = [\n    { src: '/api/local/images/src/assets/images/gallery/1.jpg', alt: 'Bride in a coral sari, framed in warm interior light' },\n    { src: '/api/local/images/src/assets/images/gallery/2.jpg', alt: 'Bridal portrait in a cream embroidered outfit' },\n    { src: '/api/local/images/src/assets/images/gallery/3.jpg', alt: 'Wedding collage with a bride and groom' },\n    { src: '/api/local/images/src/assets/images/gallery/4.jpg', alt: 'Editorial bridal portrait from behind' },\n    { src: '/api/local/images/src/assets/images/gallery/5.jpg', alt: 'Bride walking through an evening garden' },\n    { src: '/api/local/images/src/assets/images/gallery/7.jpg', alt: 'Cinematic portrait from the gallery archive' },\n    { src: '/api/local/images/src/assets/images/gallery/8.jpg', alt: 'Editorial frame from the gallery archive' }\n  ];\n  const mainFrame = document.getElementById('main-frame');\n  const frameIndex = document.getElementById('frame-index');\n  const frameTitle = document.getElementById('frame-title');\n  const frameCategory = document.getElementById('frame-category');\n  const frameCaption = document.getElementById('frame-caption');\n  const progressFill = document.getElementById('progress-fill');\n  const thumbnails = Array.from(document.querySelectorAll('.thumb-button'));\n  let current = 0;\n  function showFrame(index) {\n    current = (index + frames.length) % frames.length;\n    const thumb = thumbnails[current];\n    const frame = frames[current];\n    mainFrame.src = frame.src;\n    mainFrame.alt = thumb.dataset.alt || frame.alt;\n    frameIndex.textContent = String(current + 1).padStart(2, '0');\n    frameTitle.textContent = thumb.dataset.title;\n    frameCategory.textContent = thumb.dataset.category;\n    frameCaption.textContent = thumb.dataset.caption;\n    progressFill.style.width = `${((current + 1) / 14) * 100}%`;\n    thumbnails.forEach((button, i) => {\n      const active = i === current;\n      button.classList.toggle('is-active', active);\n      button.setAttribute('aria-selected', String(active));\n    });\n    thumb?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });\n  }\n  thumbnails.forEach((button) => button.addEventListener('click', () => showFrame(Number(button.dataset.index))));\n  document.getElementById('prev-frame').addEventListener('click', () => showFrame(current - 1));\n  document.getElementById('next-frame').addEventListener('click', () => showFrame(current + 1));\n  if (window.lucide) window.lucide.createIcons();\n</script>\n",
      "comments": [],
      "created": "2026-08-10T12:40:36.189652+00:00",
      "modified": "2026-08-10T12:44:44.114651+00:00",
